// backend/prisma/schema.prisma - FULL FIXED VERSION WITH COMPLAINT ENHANCEMENTS
generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Document {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  workerId        String        @db.ObjectId
  type            String
  url             String
  status          String        @default("pending")
  rejectionReason String?
  createdAt       DateTime      @default(now())
  WorkerProfile   WorkerProfile @relation(fields: [workerId], references: [id])
}

model EmployerProfile {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @unique @db.ObjectId
  companyName    String?
  companyLogo    String?
  companyPhotos  String[] @default([])
  companyWebsite String?
  companySize    String?
  industry       String?
  description    String?
  address        String?
  isVerified     Boolean  @default(false)

  // Rating aggregates (cached, Review records are the source of truth).
  ratingAvg      Float    @default(0)
  ratingCount    Int      @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  User           User     @relation(fields: [userId], references: [id])
}

model Experience {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  workerId      String        @db.ObjectId
  employerName  String
  role          String
  startDate     DateTime
  endDate       DateTime?
  description   String?
  createdAt     DateTime      @default(now())
  WorkerProfile WorkerProfile @relation(fields: [workerId], references: [id])
}

model Hire {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  workerId         String        @db.ObjectId
  employerId       String        @db.ObjectId
  offerId          String?       @db.ObjectId
  compensationCurrency String?
  agreedSalary     Float
  commissionAmount Float
  vatAmount        Float
  totalDue         Float
  paymentMethod    String?
  paymentReference String?
  paymentStatus    String        @default("pending")
  paymentProofUrl  String?
  startDate        DateTime?
  status           String        @default("offer_sent")

  // Work details copied from Offer
  hourlyRate         Float?
  workingHoursPerDay Float?
  workingDaysPerWeek Float?
  weeklyDaysOff      String?
  workStartTime      String?
  workEndTime        String?
  employmentStartDate DateTime?
  additionalNotes    String?

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  User             User          @relation(fields: [employerId], references: [id])
  WorkerProfile    WorkerProfile @relation(fields: [workerId], references: [id])
  Message          Message[]
  Review           Review[]
  Payment          Payment[]

  @@index([workerId, status])
  @@index([employerId, paymentStatus])
  @@index([workerId, createdAt(sort: Desc)])
  @@index([employerId, createdAt(sort: Desc)])
}

model Message {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  senderId   String   @db.ObjectId
  receiverId String   @db.ObjectId
  hireId     String?  @db.ObjectId
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  // CHAT SYSTEM FIELDS
  conversationId String?  @map("conversationId")
  senderName     String?  @map("senderName")
  senderRole     String?  @map("senderRole")
  recipientName  String?  @map("recipientName")
  recipientRole  String?  @map("recipientRole")
  delivered      Boolean  @default(true)
  updatedAt      DateTime @updatedAt @map("updatedAt")

  // Relations
  Hire                          Hire? @relation(fields: [hireId], references: [id])
  User_Message_receiverIdToUser User  @relation("Message_receiverIdToUser", fields: [receiverId], references: [id])
  User_Message_senderIdToUser   User  @relation("Message_senderIdToUser", fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
  @@index([receiverId])
  @@index([conversationId, createdAt(sort: Asc)])
}

model Notification {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  userId     String    @db.ObjectId
  type       String
  title      String
  message    String
  entityType String?
  entityId   String?
  priority   String    @default("NORMAL")
  isRead     Boolean   @default(false)
  readAt     DateTime?
  data       Json?     @default("{}")
  icon       String?   @default("🔔")
  link       String?   @default("/")
  createdAt  DateTime  @default(now())
  User       User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
}

model NotificationSettings {
  userId              String   @id @map("_id") @db.ObjectId
  newMessage          Boolean  @default(true)
  hireResponse        Boolean  @default(true)
  complaintUpdate     Boolean  @default(true)
  paymentConfirmation Boolean  @default(true)
  systemUpdate        Boolean  @default(false)
  promotional         Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model PushDevice {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @db.ObjectId
  platform       String
  tokenType      String
  token          String    @unique
  appVersion     String?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  revokedReason  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@map("push_devices")
}

model Payment {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  orderId             String    @unique @map("orderId")
  transactionId       String    @unique @map("transactionId")
  amount              Float
  currency            String    @default("EGP") @map("currency")
  providerAmount      String?
  providerCurrency    String?
  paymentMethod       String    @default("paymob") @map("paymentMethod")
  status              String    @default("pending")
  userEmail           String?   @map("userEmail")
  userId              String?   @map("userId") @db.ObjectId
  workerId            String?   @map("workerId")
  workerName          String?   @map("workerName")
  jobTitle            String?   @map("jobTitle")
  employerId          String?   @map("employerId")
  employerName        String?   @map("employerName")
  hireId              String?   @map("hireId") @db.ObjectId
  phone               String?   @map("phone")
  paymobOrderId       String?   @map("paymobOrderId")
  paymobTransactionId String?   @map("paymobTransactionId")
  paypalOrderId       String?   @map("paypalOrderId")
  approvalUrl         String?   @map("approvalUrl")
  captureId           String?   @map("captureId")
  offerId             String?   @map("offerId")
  purpose             String?   @default("COMMISSION") @map("purpose")
  metadata            Json?     @default("{}") @map("metadata")
  completedAt         DateTime? @map("completedAt")

  // FULFILLMENT LIFECYCLE — separates "money captured" (status) from
  // "entitlement granted" (fulfillmentStatus). A completed-but-unfulfilled
  // payment is retryable; fulfillment is claimed atomically so duplicate
  // callbacks/captures never grant a subscription twice or update a hire
  // twice. `status='completed'` alone must NEVER be treated as fulfilled.
  fulfillmentStatus      String    @default("pending") @map("fulfillmentStatus")
  fulfillmentAttempts    Int       @default(0) @map("fulfillmentAttempts")
  fulfillmentError       String?   @map("fulfillmentError")
  fulfillmentStartedAt   DateTime? @map("fulfillmentStartedAt")
  fulfillmentCompletedAt DateTime? @map("fulfillmentCompletedAt")

  manualPaymentReference       String?   @map("manualPaymentReference")
  manualReviewState            String?   @map("manualReviewState")
  externalTransactionReference String?   @map("externalTransactionReference")
  proofStorageKey              String?   @map("proofStorageKey")
  submittedAt                  DateTime? @map("submittedAt")
  reviewedBy                   String?   @db.ObjectId @map("reviewedBy")
  reviewedAt                   DateTime? @map("reviewedAt")
  rejectionReason              String?   @map("rejectionReason")

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  User User? @relation(fields: [userId], references: [id])
  Hire Hire? @relation(fields: [hireId], references: [id])
  Refunds PaymentRefund[]
  SubscriptionGrant SubscriptionGrant?

  @@index([userId])
  @@index([workerId])
  @@index([employerId])
  @@index([status])
  @@index([hireId])
  @@index([hireId, status])
  @@map("payments")
}

model PaymentRefund {
  id                      String    @id @default(auto()) @map("_id") @db.ObjectId
  paymentId               String    @db.ObjectId
  type                    String
  bookAmount              String
  bookCurrency            String
  requestedProviderAmount String
  providerAmount          String?
  providerCurrency        String
  providerRefundId        String?
  status                  String    @default("pending")
  reason                  String?
  requestedBy             String?   @db.ObjectId
  requestedByRole         String?
  idempotencyKey          String    @unique
  metadata                Json?     @default("{}")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  completedAt             DateTime?
  failedAt                DateTime?

  Payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId, status])
  @@index([status])
  @@index([providerRefundId])
  @@index([createdAt])
  @@map("payment_refunds")
}

// ============================================================
// REVIEW — generic directional two-way rating.
// A qualifying Hire may produce exactly one Employer→Worker review and
// one Worker→Employer review. Identities are canonical User.id values.
// WorkerProfile.id is NEVER stored as the reviewee identity; it is only
// resolved server-side to derive the Worker's canonical User.id.
// Review records are the authoritative source of truth; the cached
// ratingAvg/ratingCount on WorkerProfile/EmployerProfile are display-only.
// ============================================================
enum ReviewDirection {
  EMPLOYER_TO_WORKER
  WORKER_TO_EMPLOYER
}

model Review {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  hireId         String          @db.ObjectId
  reviewerUserId String          @db.ObjectId
  revieweeUserId String          @db.ObjectId
  direction      ReviewDirection
  rating         Int
  comment        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  Hire     Hire @relation(fields: [hireId], references: [id])
  Reviewer User @relation("ReviewReviewer", fields: [reviewerUserId], references: [id])
  Reviewee User @relation("ReviewReviewee", fields: [revieweeUserId], references: [id])

  @@index([hireId])
  @@index([reviewerUserId])
  @@index([revieweeUserId])
  @@index([direction])

  // DB-authoritative uniqueness: one review per (hire, reviewer, direction).
  // Allows Employer→Worker and Worker→Employer to coexist on the same Hire.
  @@unique([hireId, reviewerUserId, direction])
}

model User {
  id                               String           @id @default(auto()) @map("_id") @db.ObjectId
  email                            String           @unique
  password                         String
  username                         String?
  role                             Role             @default(WORKER)
  tokenVersion                     Int              @default(0)
  fullName                         String
  phone                            String           @default("")
  city                             String?
  countryCode                      String?
  countryName                      String?
  preferredCurrency                String?
  // TODO: isVerified is retained for backward compatibility.
  // It is still referenced by workerController.js, adminCommandCenterController.js
  // and routes/support.js. Phase 3 email verification uses emailVerified.
  // Migrate those readers to emailVerified before removing isVerified.
  isVerified                       Boolean          @default(false)
  isSuspended                      Boolean          @default(false)
  status                           String?
  suspendedAt                      DateTime?
  suspendedBy                      String?          @db.ObjectId
  suspensionReason                 String?
  language                         String           @default("en")
  createdAt                        DateTime         @default(now())
  updatedAt                        DateTime         @updatedAt
  profileImage                     String?          @default("")

  // ---- Profile fields from Mongoose User model ----
  // location and related profile fields keep String defaults matching
  // the existing Mongoose schema so Prisma-created documents remain
  // compatible with Mongoose-read documents.
  location                         String           @default("")
  bio                              String           @default("")
  skills                           String[]         @default([])
  experience                       String           @default("")
  hourlyRate                       String           @default("0")
  hourlyRateCurrency               String?
  companyName                      String           @default("")
  website                          String           @default("")
  profileComplete                  Boolean          @default(false)
  desiredJob                       String           @default("")
  lastLogin                        DateTime?
  passwordResetAt                  DateTime?
  mustChangePassword               Boolean          @default(false)
  settings                         Json?            @default("{}")

  // ---- Phase 3: Email Verification ----
  // Mirrors the Mongoose User model fields. Raw tokens are never stored —
  // only the SHA-256 hash in emailVerificationTokenHash.
  emailVerified                    Boolean          @default(false)
  emailVerifiedAt                  DateTime?
  emailVerificationTokenHash       String?
  emailVerificationExpiresAt       DateTime?
  emailVerificationLastSentAt      DateTime?

  EmployerProfile                  EmployerProfile?
  Hire                             Hire[]
  Message_Message_receiverIdToUser Message[]        @relation("Message_receiverIdToUser")
  Message_Message_senderIdToUser   Message[]        @relation("Message_senderIdToUser")
  Notification                     Notification[]
  ReviewReviewer                   Review[]         @relation("ReviewReviewer")
  ReviewReviewee                   Review[]         @relation("ReviewReviewee")
  WorkerProfile                    WorkerProfile?
  Payment                          Payment[]
  OfferAsEmployer                  Offer[]          @relation("EmployerOffers")
  Subscription                     Subscription[]
  ManualPremiumGrant               ManualPremiumGrant?
  SubscriptionGrant                SubscriptionGrant[]
  Complaint                        Complaint[]
  AssignedComplaints               Complaint[]      @relation("ComplaintAssignedSupport")
  SupportActivity                  SupportActivity[]
  ComplaintNote                    ComplaintNote[]
  ComplaintTimeline                ComplaintTimeline[]
  ComplaintReply                   ComplaintReply[]
  AccountDeletionRequest           AccountDeletionRequest?

  @@map("users")
}

enum AccountDeletionRequestStatus {
  pending
  processing
  blocked
  completed
  cancelled
}

model AccountDeletionRequest {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @unique @db.ObjectId
  status        AccountDeletionRequestStatus @default(pending)
  requestedAt   DateTime @default(now())
  processedAt   DateTime?
  blockedReason String?
  legalHold     Boolean  @default(false)
  lastError     String?
  retryCount    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  User User @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([status, requestedAt])
  @@map("account_deletion_requests")
}

model WorkerProfile {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  userId          String       @unique @db.ObjectId
  category        String
  experienceYears Int          @default(0)
  expectedSalary  Float        @default(0)
  availability    String       @default("available")
  // Premium-only "Actively Looking" signal. When the Worker's Premium
  // subscription is NOT active, every consumer MUST treat this as FALSE —
  // ranking/badge presentation are always gated on subscription state.
  activelyLooking Boolean      @default(false)
  workType        String       @default("full-time")
  bioAr           String?
  bioEn           String?
  skills          String[]
  profilePhotoUrl String?
  docStatus       String       @default("pending")
  ratingAvg       Float        @default(0)
  ratingCount     Int          @default(0)
  isVisible       Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  Document        Document[]
  Experience      Experience[]
  Hire            Hire[]
  Offer           Offer[]      @relation("WorkerOffers")
  User            User         @relation(fields: [userId], references: [id])
}

// ============================================================
// WORKER PAYOUT DETAILS - Private financial/payout info
// One-to-one with User (keyed by userId). Never exposed publicly.
// ============================================================
model WorkerPayoutDetails {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @unique @db.ObjectId
  walletNumber      String?
  instapayNumber    String?
  bankAccountNumber String?
  bankName          String?
  accountHolderName String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("worker_payout_details")
}

// ============================================================
// WORKER EARNING LEDGER - Contractual/pending earning periods
// A WorkerEarning record represents a CONTRACTUAL/PENDING earning
// period associated with an active hire. It is NOT proof that the
// worker received any salary — HomelyServ does not process worker
// salary payments (those are arranged directly between employer and
// worker, off-platform).
//
// Phase 1 only ever creates records with status PENDING.
// Phase 2 adds the bilateral confirmation state machine:
//   PENDING -> (worker submits) -> AWAITING_CONFIRMATION -> (employer
//   approves) -> EARNED. The employer may reject a submitted period
//   as DISPUTED. EARNED means: both parties confirmed the work period
//   was completed inside HomelyServ - NOT that any salary was paid.
// Transitions to PAID are intentionally NOT implemented yet.
//
// workerId        -> User.id (authenticated worker identity)
// workerProfileId -> WorkerProfile.id (Hire.workerId)
// idempotencyKey  -> deterministic unique key (unique index) that
//                    prevents duplicate ledger entries.
// confirmationRequestedBy -> actor (role:userId) that requested
//                    confirmation of the work period (Phase 2).
// metadata.audit  -> append-only log of confirmation events.
// ============================================================
model WorkerEarning {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  workerId        String    @db.ObjectId
  workerProfileId String    @db.ObjectId
  employerId      String    @db.ObjectId
  hireId          String    @db.ObjectId
  offerId         String?   @db.ObjectId
  amount          Float
  currency        String    @default("EGP") @map("currency")
  earningType     String
  status          String    @default("PENDING") @map("status")
  periodStart     DateTime?
  periodEnd       DateTime?
  earnedAt        DateTime? @map("earnedAt")
  dueAt           DateTime? @map("dueAt")
  paidAt          DateTime? @map("paidAt")

  // ---- Phase 2: bilateral confirmation state (see model comment) ----
  confirmationRequestedAt  DateTime?
  confirmationRequestedBy  String?
  confirmedByWorkerAt      DateTime?
  confirmedByEmployerAt    DateTime?
  confirmedAt              DateTime?

  idempotencyKey  String    @unique
  metadata        Json?     @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workerId])
  @@index([workerProfileId])
  @@index([employerId])
  @@index([hireId])
  @@index([status])
  @@map("worker_earnings")
}

enum Role {
  WORKER
  EMPLOYER
  ADMIN
  SUPPORT
}

model Offer {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  employerId String @db.ObjectId
  workerId   String @db.ObjectId
  jobPostId  String? @db.ObjectId
  applicationId String? @db.ObjectId

  jobTitle String
  message  String?

  salary Float
  compensationCurrency String?
  status String @default("pending")

  employerName   String?
  employerEmail  String?
  workerName     String?
  workerEmail    String?
  workerPhone    String?
  workerLocation String?
  workerRating   Float?
  workerSkills   String[]
  workerImage    String?
  hourlyRate     Float?
  amount         Float?
  description    String?

  // Work details stored at offer creation
  workingHoursPerDay Float?
  workingDaysPerWeek Float?
  weeklyDaysOff      String?
  workStartTime      String?
  workEndTime        String?
  employmentStartDate DateTime?
  additionalNotes    String?

  contactRevealed Boolean? @default(false)
  paymentConfirmed Boolean? @default(false)
  paymentVerified Boolean? @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Employer User          @relation("EmployerOffers", fields: [employerId], references: [id])
  Worker   WorkerProfile @relation("WorkerOffers", fields: [workerId], references: [id])

  @@index([jobPostId])
  @@index([applicationId])
  @@index([workerId, status])
  @@index([workerId, createdAt(sort: Desc)])
  @@index([employerId, createdAt(sort: Desc)])
}

// ============================================================
// JOB POST — Phase 1 Job Marketplace (no applications yet).
// employerId is always the authenticated Employer User.id (set
// server-side, never trusted from the request body).
// Status values: open | paused | closed. Workers only ever see
// `open` posts; the owning employer can see/manage their own in
// any status. isUrgent/isFeatured are informational flags only in
// Phase 1 (no paid/boosted behavior).
// ============================================================
model JobPost {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  employerId         String    @db.ObjectId

  jobTitle           String
  description        String?
  location           String?

  salaryMin          Float?
  salaryMax          Float?
  compensationCurrency String?
  employmentType     String    @default("full-time")
  contractType       String?

  workingHoursPerDay Float?
  workingDaysPerWeek Float?
  weeklyDaysOff      String?
  workStartTime      String?
  workEndTime        String?
  employmentStartDate DateTime?
  deadline           DateTime?

  requirements       String[]
  benefits           String[]

  isUrgent           Boolean   @default(false)
  isFeatured         Boolean   @default(false)
  status             String    @default("open")

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([employerId, status])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("job_posts")
}

// ============================================================
// JOB APPLICATION — Phase 2 Job Marketplace
// workerId = authenticated Worker User.id
// workerProfileId = WorkerProfile.id resolved server-side
// employerId = JobPost.employerId derived server-side
// Statuses: applied | shortlisted | rejected | withdrawn | offer_sent
// ============================================================
model JobApplication {
  id               String                  @id @default(auto()) @map("_id") @db.ObjectId
  jobPostId        String                  @db.ObjectId
  workerId         String                  @db.ObjectId
  workerProfileId  String                  @db.ObjectId
  employerId       String                  @db.ObjectId
  coverMessage     String?
  status           JobApplicationStatus    @default(applied)
  // Set atomically when an Offer is created for this application.
  // Used as the idempotency/claim guard so one application can
  // produce at most ONE Offer even under concurrent requests.
  offerId          String?                 @db.ObjectId
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([jobPostId, workerId])
  @@index([jobPostId])
  @@index([workerId])
  @@index([employerId, status])
  @@index([offerId])
  @@map("job_applications")
}

enum JobApplicationStatus {
  applied
  shortlisted
  rejected
  withdrawn
  offer_sent
}

model Subscription {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @db.ObjectId

  plan   String
  amount Float
  status String @default("active")

  startDate DateTime @default(now())
  endDate   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  User User @relation(fields: [userId], references: [id])
}

// Current manual Premium state. This is intentionally separate from paid
// Subscription rows; service migration is deferred to a later phase.
model ManualPremiumGrant {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId
  status    String   @default("inactive")
  startDate DateTime
  endDate   DateTime
  adminId   String?  @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  User User @relation(fields: [userId], references: [id])

  @@map("manual_premium_grants")
}

model SubscriptionGrant {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId
  paymentId       String    @unique @db.ObjectId
  plan            String
  purchaserRole   String
  durationDays    Int
  startsAt        DateTime
  endsAt          DateTime
  status          String    @default("active")
  createdAt       DateTime  @default(now())
  reversedAt      DateTime?
  reversalReason  String?
  reversedBy      String?   @db.ObjectId
  metadata        Json?     @default("{}")

  User    User    @relation(fields: [userId], references: [id])
  Payment Payment @relation(fields: [paymentId], references: [id])

  @@index([userId, status])
  @@index([endsAt])
  @@map("subscription_grants")
}

model EmployerSearchTracking {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  employerId     String    @db.ObjectId
  searchCount    Int       @default(0)
  lastResetDate  DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ============================================================
// ENHANCED COMPLAINT MODEL - Full lifecycle support
// ============================================================
model Complaint {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  ticketNumber     String?   @unique
  userId           String    @db.ObjectId
  subject          String
  description      String
  status           String    @default("NEW")
  priority         String    @default("medium")
  category         String?   @default("Other")
  assignedTo       String?   @db.ObjectId
  assignedSupport  String?   @db.ObjectId
  assignedAdmin    String?   @db.ObjectId
  escalatedBy      String?   @db.ObjectId
  escalatedAt      DateTime?
  escalationReason String?
  internalNotes    String?
  adminNotes       String?
  attachments      String[]  @default([])
  resolvedAt       DateTime?
  closedAt         DateTime?

  // ---- Phase 2: dispute resolution (Hire completeness) ----
  hireId          String?   @db.ObjectId
  workerEarningId String?   @db.ObjectId

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  User             User             @relation(fields: [userId], references: [id])
  AssignedSupport  User?            @relation("ComplaintAssignedSupport", fields: [assignedSupport], references: [id])
  SupportActivity  SupportActivity[]
  Notes            ComplaintNote[]
  Timeline         ComplaintTimeline[]
  Replies          ComplaintReply[]
}

// ============================================================
// COMPLAINT REPLIES - Public conversation thread messages
// Visible to all authorized participants (user, support, admin).
// Ordered by createdAt ASC for the conversation thread.
// ============================================================
model ComplaintReply {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  complaintId String    @db.ObjectId
  authorId    String    @db.ObjectId
  authorName  String
  authorRole  String
  message     String
  attachments String[]  @default([])
  createdAt   DateTime  @default(now())

  Complaint   Complaint @relation(fields: [complaintId], references: [id])
  Author      User      @relation(fields: [authorId], references: [id])

  @@index([complaintId])
  @@index([complaintId, createdAt(sort: Asc)])
}

// ============================================================
// COMPLAINT NOTES - Internal notes (invisible to users)
// ============================================================
model ComplaintNote {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  complaintId String    @db.ObjectId
  authorId    String    @db.ObjectId
  authorName  String
  authorRole  String
  note        String
  isInternal  Boolean   @default(true)
  createdAt   DateTime  @default(now())

  Complaint   Complaint @relation(fields: [complaintId], references: [id])
  Author      User      @relation(fields: [authorId], references: [id])

  @@index([complaintId])
}

// ============================================================
// COMPLAINT TIMELINE - Activity log for each complaint
// ============================================================
model ComplaintTimeline {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  complaintId String    @db.ObjectId
  action      String
  description String
  authorId    String?   @db.ObjectId
  authorName  String?
  authorRole  String?
  oldValue    String?
  newValue    String?
  createdAt   DateTime  @default(now())

  Complaint   Complaint @relation(fields: [complaintId], references: [id])
  Author      User?     @relation(fields: [authorId], references: [id])

  @@index([complaintId])
  @@index([complaintId, createdAt(sort: Desc)])
}

model SupportActivity {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  supportId     String    @db.ObjectId
  action        String
  targetUserId  String?   @db.ObjectId
  complaintId   String?   @db.ObjectId
  description   String
  createdAt     DateTime  @default(now())

  User          User      @relation(fields: [supportId], references: [id])
  Complaint     Complaint? @relation(fields: [complaintId], references: [id])
}

// ============================================================
// TICKET COUNTER - Persistent sequential ticket number generator
// ============================================================
model TicketCounter {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  year      Int      @unique
  sequence  Int      @default(0)
  updatedAt DateTime @updatedAt
}
