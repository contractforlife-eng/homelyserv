# HomelyMind account-link integration
# Shared only between HomelyServ and HomelyMind. Use a different secret per environment.
# Account-link tokens expire after 5 minutes and are intended only for account linking.
# HomelyMind must never receive HomelyServ passwords or connect directly to the HomelyServ database.
HOMELYMIND_URL=
HOMELYMIND_INTEGRATION_SECRET=
