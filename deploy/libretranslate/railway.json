# Railway Service Configuration for LibreTranslate
# Docs: https://docs.railway.com/reference/railway-json-reference

{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/libretranslate/Dockerfile"
  },
  "deploy": {
    "startCommand": "libretranslate --host 0.0.0.0 --port ${PORT:-5000} --load-only en,ar,fr,ru,tr,de",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
